{
  "manifest_version": 3,
  "name": "Cookie Translator",
  "version": "1.0.0",
  "description": "Traduce el banner de cookies a lenguaje humano antes de que aceptes. / Translates cookie banners into plain language.",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/i18n.js", "src/detect.js", "src/panel.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["data/gvl.json"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-translator@acedo258.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
